{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,mjs,json,css}",
      "cli/**/*.{ts,tsx,js,json}",
      "scripts/**/*.{ts,tsx,mts,mjs}",
      "*.{ts,json,html}",
      "!src/components/ui/**",
      "!src/components/ai-elements/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":NODE:", ["@/**"], ":PACKAGE:", ":ALIAS:", ":PATH:"]
          }
        }
      }
    },
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "cli/**/*.ts",
      "cli/**/*.tsx",
      "scripts/build-tui.ts",
      "scripts/build.mjs",
      "scripts/terminal-*.ts",
      "scripts/terminal-*.tsx",
      "!src/components/ui/**",
      "!src/components/ai-elements/**"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn",
        "useFocusableInteractive": "warn",
        "noStaticElementInteractions": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noSvgWithoutTitle": "warn",
        "noNoninteractiveTabindex": "warn",
        "noLabelWithoutControl": "warn"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn",
        "noTsIgnore": "error"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "useIndexOf": "warn",
        "noBannedTypes": "warn"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn",
        "useTemplate": "warn",
        "useExportType": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "warn",
        "useParseIntRadix": "warn",
        "noUnusedVariables": "warn"
      },
      "performance": {
        "noAccumulatingSpread": "warn"
      }
    },
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "cli/**/*.ts",
      "cli/**/*.tsx",
      "scripts/build-tui.ts",
      "scripts/build.mjs",
      "scripts/terminal-*.ts",
      "scripts/terminal-*.tsx",
      "!src/components/ui/**",
      "!src/components/ai-elements/**"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/components/controls/**",
        "!src/components/ui/**",
        "!src/components/ai-elements/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/components/ui/button": "业务代码统一从 @/components/controls/button 导入。",
                  "@/components/ui/input": "业务代码统一从 @/components/controls/input 导入。",
                  "@/components/ui/textarea": "业务代码统一从 @/components/controls/textarea 导入。",
                  "@/components/ui/select": "业务代码统一从 @/components/controls/select 导入。",
                  "@/components/ui/dialog": "业务对话框统一从 @/components/controls/dialog 导入。",
                  "@/components/ui/alert-dialog": "业务对话框统一从 @/components/controls/alert-dialog 导入。",
                  "@/components/ui/tooltip": "悬停提示统一从 @/components/controls/tooltip 导入。",
                  "@/components/ui/hover-card": "悬停详情统一使用 @/components/controls/tooltip。"
                }
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  }
}
