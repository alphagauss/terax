    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "analyze:bundle": "ANALYZE=true vite build",
    "analyze:eager": "node scripts/eager-graph.mjs src/main.tsx && node scripts/eager-graph.mjs src/auxiliary/main.tsx",
    "size": "size-limit",
    "knip": "knip",
    "agent": "bun cli/index.ts agent",
    "build:host": "cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --features headless --bin terax-host --locked",
    "check-types:terminal": "tsc --noEmit -p cli/tsconfig.json",
    "test:terminal": "bun scripts/terminal-smoke.ts",
    "test:tui": "bun scripts/terminal-ui-smoke.tsx",
    "test:tui:package": "bun scripts/terminal-package-smoke.ts"
